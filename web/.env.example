SERVER_WEBVIEW_PUBLIC_BASE_URL=http://localhost:8000
SERVER_WEBVIEW_HOST=127.0.0.1
SERVER_WEBVIEW_PORT=8000
SERVER_WEBVIEW_DEBUG=0
SERVER_WEBVIEW_SILENT_BOOT=1
SERVER_WEBVIEW_DATA_DIR=
SERVER_WEBVIEW_CONTENT_DIR=
# Optional Open Cloud key for assets your account has permission to download.
SERVER_WEBVIEW_ROBLOX_API_KEY=
# Optional path to a private .ROBLOSECURITY file outside the repository/shared storage.
# The file is read on each asset request, so changing it does not require a restart.
SERVER_WEBVIEW_ROBLOX_SECURITY_FILE=
# Optional path to an accessible Roblox client content/ directory for rbxasset:// files.
# The server does not download Roblox client files; see docs/asset-delivery.md.
SERVER_WEBVIEW_ROBLOX_CLIENT_CONTENT_DIR=
# Legacy direct value fallback; prefer the file above.
SERVER_WEBVIEW_ROBLOX_SECURITY=
